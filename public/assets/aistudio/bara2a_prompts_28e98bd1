import { cn } from "@/lib/utils";


import {


  Home,


  Scale,


  Users,


  CheckSquare,


  Calendar,


  FileText,


  MessageSquare,


  ShieldCheck,


  Inbox,


  Clock,


  Receipt,


  CreditCard,


  Bot,


  Brain,


  BookOpen,


  Settings2,


  LayoutGrid,


  Puzzle,


  Link2,


  Globe,


  PenSquare,


  BarChart3,


  Settings,


  ChevronRight,


  LogOut,


} from "lucide-react";


// ─── Types ────────────────────────────────────────────────────────────────────


interface NavItem {


  label: string;           // Arabic label


  to: string;              // route path


  icon: React.ElementType; // lucide-react icon component


  pro?: boolean;           // show PRO badge


  roles?: string[];        // allowed roles (undefined = all roles)


}


interface NavSection {


  title: string;           // Arabic section heading


  items: NavItem[];


  roles?: string[];        // section-level role gate (hides entire section)


}


// ─── Role constants ───────────────────────────────────────────────────────────


const SENIOR_ROLES = ["شريك", "مشرف", "محامٍ أول"];


const ADMIN_ROLES  = ["شريك", "مشرف"];


// ─── Navigation definition ────────────────────────────────────────────────────


const NAV_SECTIONS: NavSection[] = [


  // ── الرئيسية ────────────────────────────────────────────────────────────────


  {


    title: "الرئيسية",


    items: [


      { label: "الرئيسية",  to: "/home",    icon: Home },


    ],


  },


  // ── القانونية ───────────────────────────────────────────────────────────────


  {


    title: "القانونية",


    items: [


      { label: "القضايا",         to: "/cases",           icon: Scale },


      { label: "العملاء",         to: "/clients",         icon: Users },


      { label: "المهام",          to: "/tasks",           icon: CheckSquare },


      { label: "المواعيد",        to: "/calendar",        icon: Calendar },


      { label: "المستندات",       to: "/documents",       icon: FileText },


      { label: "الاستشارات",      to: "/consultations",   icon: MessageSquare },


      { label: "فحص التعارض",    to: "/conflict-checks", icon: ShieldCheck },


      { label: "الاستعلامات",     to: "/inquiries",       icon: Inbox },


      { label: "قيود الوقت",     to: "/time-entries",    icon: Clock },


    ],


  },


  // ── المالية ─────────────────────────────────────────────────────────────────


  {


    title: "المالية",


    items: [


      { label: "الفواتير",    to: "/billing",      icon: Receipt },


      { label: "الاشتراكات", to: "/subscription", icon: CreditCard, pro: true },


    ],


  },


