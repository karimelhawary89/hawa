  {


    title: "المحتوى",


    items: [


      { label: "المواقع القانونية", to: "/legal-websites", icon: Globe },


      { label: "المدونة (إدارة)", to: "/blog-admin",     icon: PenSquare,  roles: ADMIN_ROLES },


    ],


  },


  // ── النظام ──────────────────────────────────────────────────────────────────


  {


    title: "النظام",


    items: [


      { label: "التقارير",  to: "/reports",  icon: BarChart3 },


      { label: "الإعدادات", to: "/settings", icon: Settings },


    ],


  },


];


// ─── ProBadge ─────────────────────────────────────────────────────────────────


function ProBadge() {


  return (


    <span className="mr-1 rounded px-1.5 py-0.5 text-[10px] font-bold leading-none bg-[#f59e0b] text-[#1a2234]">


      PRO


    </span>


  );


}


// ─── NavLink ──────────────────────────────────────────────────────────────────


function NavLink({ item }: { item: NavItem }) {


  const location = useLocation();


  const isActive =


    item.to === "/home"


      ? location.pathname === "/" || location.pathname === "/home"


      : location.pathname.startsWith(item.to);


  return (


    <Link


      to={item.to}


      className={cn(


        "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-tajawal transition-colors duration-150",


        isActive


          ? "bg-[#f59e0b]/10 text-[#f59e0b] font-semibold"


          : "text-slate-300 hover:bg-slate-700/50 hover:text-white"


      )}


    >


      {/* Icon */}


      <item.icon


        size={16}


        className={isActive ? "text-[#f59e0b]" : "text-slate-400"}


      />


      {/* Label */}


      <span className="flex-1 text-right">{item.label}</span>


      {/* PRO badge */}


      {item.pro && <ProBadge />}


      {/* Active indicator */}


      {isActive && (


        <ChevronRight size={14} className="text-[#f59e0b] rotate-180" />


      )}


    </Link>


  );


}


// ─── Sidebar ──────────────────────────────────────────────────────────────────


export default function Sidebar() {


  const { user, logout } = useAuth();


  const { isPro } = usePlan();


  const userRole: string = user?.role ?? "";


  return (


    <aside


      dir="rtl"


      className="flex h-screen w-64 flex-col bg-[#1a2234] border-l border-slate-700/50 shadow-xl"


    >


      {/* ── Logo / brand ─────────────────────────────────────────────── */}


      <div className="flex items-center gap-3 border-b border-slate-700/50 px-5 py-4">


        <div className="flex h-9 w-9 items-center justify-center rounded-lg bg-[#f59e0b]">


          <Scale size={20} className="text-[#1a2234]" />


        </div>


        <div>


          <p className="font-cairo text-base font-bold text-white leading-tight">


            براءة


          </p>


          <p className="text-[11px] text-slate-400 font-tajawal">


            {isPro ? "النظام القانوني المتكامل" : "الإصدار المجاني"}


          </p>


        </div>


      </div>


      {/* ── Navigation ───────────────────────────────────────────────── */}


      <nav className="flex-1 overflow-y-auto px-3 py-4 space-y-6 scrollbar-thin scrollbar-thumb-slate-700">


        {NAV_SECTIONS.map((section) => {


          // Section-level role gate


          if (


            section.roles &&


            !section.roles.includes(userRole)


          ) {


            return null;


          }


          // Filter items by role


          const visibleItems = section.items.filter(


            (item) =>


              !item.roles || item.roles.includes(userRole)


          );


          if (visibleItems.length === 0) return null;


          return (


            <div key={section.title}>


              {/* Section heading */}


              <p className="mb-1.5 px-3 text-[11px] font-semibold uppercase tracking-wider text-slate-500 font-tajawal">


                {section.title}


              </p>


              {/* Items */}


              <div className="space-y-0.5">


                {visibleItems.map((item) => (


                  <NavLink key={item.to} item={item} />


                ))}


              </div>


            </div>


          );


        })}


      </nav>


      {/* ── User footer ──────────────────────────────────────────────── */}


      <div className="border-t border-slate-700/50 px-4 py-3">


        <div className="flex items-center gap-3">


          {/* Avatar placeholder */}


          <div className="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-[#f59e0b]/20 text-[#f59e0b] font-cairo font-bold text-sm">


            {user?.name?.charAt(0) ?? "م"}


          </div>


          <div className="flex-1 overflow-hidden">


            <p className="truncate text-sm font-semibold text-white font-cairo">


              {user?.name ?? "المستخدم"}


            </p>


            <p className="truncate text-xs text-slate-400 font-tajawal">


              {userRole}


              {isPro && (


                <span className="mr-1 text-[#f59e0b] font-bold"> · PRO</span>


              )}


            </p>


          </div>


          <button


            onClick={logout}


            className="text-slate-400 hover:text-red-400 transition-colors"


            title="تسجيل الخروج"


          >


            <LogOut size={16} />


          </button>


        </div>


      </div>


    </aside>


  );


}


```


**IMPORTANT — Sidebar.tsx notes:**


1. The `usePlan()` hook is imported from `@/hooks/usePlan` — this is the Step 1 hook.


2. `ProBadge` uses gold `#f59e0b` text on dark background — no emoji characters.


3. RBAC: The `SENIOR_ROLES` array (`["شريك", "مشرف", "محامٍ أول"]`) gates both the Knowledge and Widget/Integration sections at the section level, then again at the item level for safety.


4. Blog admin (`/blog-admin`) is gated to `ADMIN_ROLES` (`["شريك", "مشرف"]`) only.


5. Do NOT add any emoji characters to labels or icons. Use lucide-react icons exclusively.


6. The `scrollbar-thin` class requires the `tailwind-scrollbar` plugin — if not installed, remove those classes; the sidebar still works.


