    setCollapsedSections((prev) => {


      const next = new Set(prev);


      if (next.has(title)) {


        next.delete(title);


      } else {


        next.add(title);


      }


      return next;


    });


  }


  function isActive(path: string) {


    if (path === "/") return location.pathname === "/";


    return location.pathname.startsWith(path);


  }


  return (


    <aside


      className="w-64 min-h-screen bg-[#1e2a40] border-l border-[#2a3a54] flex flex-col overflow-y-auto"


      dir="rtl"


    >


