            النظام القانوني


          </p>


        </div>


      </div>


      {/* Navigation */}


      <nav className="flex-1 px-3 py-3">


        {NAV_SECTIONS.map((section) => {


          const isCollapsed = collapsedSections.has(section.title);


          return (


            <div key={section.title} className="mb-1">


              {/* Section Header */}


              <button


                onClick={() => toggleSection(section.title)}


                className="w-full flex items-center justify-between px-3 py-1.5 mb-0.5 group"


              >


                <div className="flex items-center gap-2">


                  <span


                    className="text-[11px] font-semibold text-gray-500 uppercase tracking-wider"


                    style={{ fontFamily: "Tajawal, sans-serif" }}


                  >


                    {section.title}


                  </span>


                  {section.isPro && !isPro && <ProBadge />}


                </div>


                {isCollapsed ? (


                  <ChevronLeft className="w-3 h-3 text-gray-600"                ) : (


                  <ChevronDown className="w-3 h-3 text-gray-600" />


                )}


              </button>


              {/* Nav Items */}


              {!isCollapsed && (


                <div className="space-y-0.5">


                  {section.items.map((item) => {


                    const Icon = item.icon;


                    const active = isActive(item.path);


                    // Admin-only: hide for non-admin users (in INTERNAL mode all users are shown)


                    return (


                      <Link


                        key={item.path}


                        to={item.path}


                        className={`


                          flex items-center gap-3 px-3 py-2 rounded-xl text-sm transition-all duration-150


                          ${active


