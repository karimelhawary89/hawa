interface StatCardProps {


  label: string;


  value: string | number;


  icon: React.ElementType;


  color: string;


  to?: string;


}


function StatCard({ label, value, icon: Icon, color, to }: StatCardProps) {


  const content = (


    <div


      className={`bg-[#1e2a40] rounded-2xl p-5 border border-[#2a3a54] hover:border-amber-500/30 transition-all duration-200 cursor-pointer group`}


    >


      <div className="flex items-start justify-between">


        <div>


          <p className="text-gray-500 text-sm mb-1" style={{ fontFamily: "Tajawal, sans-serif" }}>


            {label}


          </p>


          <p className="text-3xl font-bold text-white" style={{ fontFamily: "Cairo, sans-serif" }}>


            {value}


          </p>


        </div>


        <div className={`w-11 h-11 rounded-xl flex items-center justify-center ${color}`}>


          <Icon className="w-5 h-5" />


        </div>


      </div>


    </div>


  );


  if (to) return <Link to={to}>{content}</Link>;


  return content;


}


interface QuickLinkProps {


  label: string;


  description: string;


  icon: React.ElementType;


  to: string;


  isPro?: boolean;


  color: string;


}


function QuickLink({ label, description, icon: Icon, to, isPro, color }: QuickLinkProps) {


  return (


    <Link


      to={to}


      className="flex items-center gap-4 bg-[#1e2a40] rounded-2xl p-4 border border-[#2a3a54] hover:border-amber-500/30 transition-all duration-200 group"


    >


      <div className={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${color}`}>


        <Icon className="w-5 h-5" />


      </div>


      <div className="flex-1 min-w-0">


        <div className="flex items-center gap-2">


          <p className="text-white text-sm font-semibold" style={{ fontFamily: "Tajawal, sans-serif" }}>


            {label}


          </p>


          {isPro && (


            <span className="text-[10px] font-bold bg-amber-500 text-[#1a2234] px-1.5 py-0.5 rounded-full">


              PRO


            </span>


          )}


        </div>


        <p className="text-gray-500 text-xs truncate" style={{ fontFamily: "Tajawal, sans-serif" }}>


          {description}


        </p>


      </div>


      <ArrowLeft className="w-4 h-4 text-gray-600 group-hover:text-amber-400 transition-colors flex-shrink-0" />


    </Link>


  );


}


