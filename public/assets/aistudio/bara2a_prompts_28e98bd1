function renderMarkdownLite(content: string): React.ReactNode[] {


  if (!content) return [];


  const lines = content.split("\n");


  const elements: React.ReactNode[] = [];


  let i = 0;


  while (i < lines.length) {


    const line = lines[i];


    if (line.startsWith("## ")) {


      elements.push(


        <h2 key={i} className="text-xl font-bold text-amber-400 mt-8 mb-3" style={{ fontFamily: "Cairo, sans-serif" }}>


          {line.replace("## ", "")}


        </h2>


      );


    } else if (line.startsWith("# ")) {


      elements.push(


        <h1 key={i} className="text-2xl font-bold text-white mt-6 mb-4" style={{ fontFamily: "Cairo, sans-serif" }}>


          {line.replace("# ", "")}


        </h1>


      );


    } else if (line.startsWith("### ")) {


      elements.push(


        <h3 key={i} className="text-lg font-bold text-amber-300 mt-6 mb-2" style={{ fontFamily: "Cairo, sans-serif" }}>


          {line.replace("### ", "")}


        </h3>


      );


    } else if (line.startsWith("**") && line.endsWith("**")) {


      elements.push(


        <p key={i} className="font-bold text-white my-2" style={{ fontFamily: "Tajawal, sans-serif" }}>


          {line.replace(/\*\*/g, "")}


        </p>


      );


    } else if (line.startsWith("- ")) {


      elements.push(


        <li key={i} className="text-gray-300 my-1 mr-4 list-disc" style={{ fontFamily: "Tajawal, sans-serif" }}>


          {line.replace("- ", "")}


        </li>


      );


    } else if (line.trim() === "") {


      elements.push(<div key={i} className="h-2" />);


    } else {


      elements.push(


        <p key={i} className="text-gray-300 leading-relaxed my-2" style={{ fontFamily: "Tajawal, sans-serif" }}>


          {line}


        </p>


      );


    }


    i++;


  }


  return elements;


}


