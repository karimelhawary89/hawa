import React, { useState, useMemo } from "react";


import { ExternalLink, Star, Search, Globe, Filter } from "lucide-react";


import { Input } from "@/components/ui/input";


import { Badge } from "@/components/ui/badge";


import { Button } from "@/components/ui/button";


import { Switch } from "@/components/ui/switch";


import { Label } from "@/components/ui/label";


import { useLegalWebsites } from "@/hooks/useLegalWebsites";


const CATEGORIES = ["الكل", "حكومي", "قضائي", "تنظيمي", "تشريعي", "أكاديمي", "مهني", "إخباري", "دولي"];


const COUNTRIES = ["الكل", "مصر", "السعودية", "الإمارات", "الكويت", "البحرين", "قطر", "عُمان", "دولي"];


const CATEGORY_COLORS: Record<string, string> = {


  حكومي: "bg-blue-900/50 text-blue-300 border border-blue-700",


  قضائي: "bg-purple-900/50 text-purple-300 border border-purple-700",


  تنظيمي: "bg-orange-900/50 text-orange-300 border border-orange-700",


  تشريعي: "bg-green-900/50 text-green-300 border border-green-700",


  أكاديمي: "bg-teal-900/50 text-teal-300 border border-teal-700",


  مهني: "bg-indigo-900/50 text-indigo-300 border border-indigo-700",


  إخباري: "bg-rose-900/50 text-rose-300 border border-rose-700",


  دولي: "bg-yellow-900/50 text-yellow-300 border border-yellow-700",


};


export default function LegalWebsites() {


  const { websites, isLoading } = useLegalWebsites();


  const [searchQuery, setSearchQuery] = useState("");


  const [selectedCategory, setSelectedCategory] = useState("الكل");


  const [selectedCountry, setSelectedCountry] = useState("الكل");


  const [showFeaturedOnly, setShowFeaturedOnly] = useState(false);


  const filtered = useMemo(() => {


    return (websites || []).filter((site) => {


      const matchesSearch =


        searchQuery === "" ||


        site.name_ar?.includes(searchQuery) ||


        site.name_en?.toLowerCase().includes(searchQuery.toLowerCase()) ||


        site.description_ar?.includes(searchQuery);


      const matchesCategory =


        selectedCategory === "الكل" || site.category === selectedCategory;


      const matchesCountry =


        selectedCountry === "الكل" || site.country === selectedCountry;


      const matchesFeatured = !showFeaturedOnly || site.is_featured;


      return matchesSearch && matchesCategory && matchesCountry && matchesFeatured;


    });


  }, [websites, searchQuery, selectedCategory, selectedCountry, showFeaturedOnly]);


  return (


    <div className="min-h-screen bg-[#1a2234] text-white" dir="rtl">


      {/* Page Header */}


      <div className="bg-[#1e2a40] border-b border-[#2a3a54] px-6 py-8">


        <div className="max-w-7xl mx-auto">


          <div className="flex items-center gap-3 mb-2">


            <div className="w-10 h-10 rounded-xl bg-amber-500/20 flex items-center justify-center">


              <Globe className="w-5 h-5 text-amber-400" />


            </div>


            <h1 className="text-3xl font-bold text-white" style={{ fontFamily: "Cairo, sans-serif" }}>


              المواقع القانونية


            </h1>


          </div>


          <p className="text-gray-400 text-lg mr-13" style={{ fontFamily: "Tajawal, sans-serif" }}>


            دليلك الشامل للمواقع القانونية العربية والدولية


          </p>


          <div className="mt-4 flex items-center gap-4 text-sm text-gray-500">


            <span>{(websites || []).length} موقع قانوني</span>


            <span>•</span>


            <span>يشمل مصر ودول الخليج والمواقع الدولية</span>


          </div>


        </div>


      </div>


      <div className="max-w-7xl mx-auto px-6 py-6">


        {/* Search and Featured Toggle */}


        <div className="flex flex-col md:flex-row gap-4 mb-6">


          <div className="relative flex-1">


            <Search className="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />


            <Input


              value={searchQuery}


              onChange={(e) => setSearchQuery(e.target.value)}


              placeholder="ابحث عن موقع قانوني..."


              className="bg-[#1e2a40] border-[#2a3a54] text-white placeholder:text-gray-500 pr-10 text-right"


              style={{ fontFamily: "Tajawal, sans-serif" }}


            />


          </div>


          <div className="flex items-center gap-3 bg-[#1e2a40] border border-[#2a3a54] rounded-xl px-4 py-2">


            <Star className="w-4 h-4 text-amber-400" />


            <Label htmlFor="featured-toggle" className="text-gray-300 text-sm cursor-pointer" style={{ fontFamily: "Tajawal, sans-serif" }}>


              المميزة فقط


            </Label>


            <Switch


              id="featured-toggle"


              checked={showFeaturedOnly}


              onCheckedChange={setShowFeaturedOnly}


            />


          </div>


        </div>


        {/* Category Filter */}


        <div className="mb-4">


          <div className="flex items-center gap-2 mb-2">


            <Filter className="w-4 h-4 text-gray-400" />


            <span className="text-xs text-gray-400" style={{ fontFamily: "Tajawal, sans-serif" }}>التصنيف</span>


          </div>


          <div className="flex flex-wrap gap-2">


            {CATEGORIES.map((cat) => (


              <button


                key={cat}


                onClick={() => setSelectedCategory(cat)}


                className={`px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 ${


                  selectedCategory === cat


                    ? "bg-amber-500 text-[#1a2234]"


                    : "bg-[#1e2a40] border border-[#2a3a54] text-gray-300 hover:border-amber-500/50 hover:text-amber-300"


                }`}


                style={{ fontFamily: "Tajawal, sans-serif" }}


              >


                {cat}


              </button>


            ))}


          </div>


        </div>


        {/* Country Filter */}


        <div className="mb-8">


          <div className="flex items-center gap-2 mb-2">


            <Globe className="w-4 h-4 text-gray-400" />


            <span className="text-xs text-gray-400" style={{ fontFamily: "Tajawal, sans-serif" }}>الدولة</span>


          </div>


          <div className="flex flex-wrap gap-2">


            {COUNTRIES.map((country) => (


              <button


                key={country}


                onClick={() => setSelectedCountry(country)}


                className={`px-4 py-1.5 rounded-full text-sm font-medium transition-all duration-200 ${


                  selectedCountry === country


                    ? "bg-amber-500 text-[#1a2234]"


                    : "bg-[#1e2a40] border border-[#2a3a54] text-gray-300 hover:border-amber-500/50 hover:text-amber-300"


                }`}


                style={{ fontFamily: "Tajawal, sans-serif" }}


              >


                {country}


              </button>


            ))}


          </div>


        </div>


        {/* Results Count */}


        <div className="mb-4 text-sm text-gray-400" style={{ fontFamily: "Tajawal, sans-serif" }}>


          عرض {filtered.length} موقع


          {searchQuery && ` • نتائج البحث عن "${searchQuery}"`}


        </div>


        {/* Loading State */}


        {isLoading && (


          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">


            {Array.from({ length: 9 }).map((_, i) => (


              <div key={i} className="rounded-2xl bg-[#1e2a40] border border-[#2a3a54] p-5 animate-pulse h-48" />


            ))}


          </div>


        )}


        {/* Empty State */}


        {!isLoading && filtered.length === 0 && (


          <div className="flex flex-col items-center justify-center py-24 text-center">


            <Globe className="w-16 h-16 text-gray-600 mb-4" />


            <h3 className="text-xl font-semibold text-gray-400 mb-2" style={{ fontFamily: "Cairo, sans-serif" }}>


              لا توجد نتائج


            </h3>


            <p className="text-gray-500" style={{ fontFamily: "Tajawal, sans-serif" }}>


              لم نجد مواقع مطابقة لمعايير البحث الحالية


            </p>


            <Button


              variant="outline"


              className="mt-4 border-amber-500/50 text-amber-400 hover:bg-amber-500/10"


              onClick={() => {


                setSearchQuery("");


                setSelectedCategory("الكل");


                setSelectedCountry("الكل");


                setShowFeaturedOnly(false);


              }}


              style={{ fontFamily: "Tajawal, sans-serif" }}


            >


              إعادة ضبط الفلاتر


            </Button>


          </div>


        )}


        {/* Website Cards Grid */}


        {!isLoading && filtered.length > 0 && (


          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">


            {filtered


              .sort((a, b) => {


                if (a.is_featured && !b.is_featured) return -1;


                if (!a.is_featured && b.is_featured) return 1;


                return (a.sort_order || 0) - (b.sort_order || 0);


              })


              .map((site) => (


                <div


                  key={site.id}


                  className={`relative rounded-2xl bg-[#1e2a40] border transition-all duration-300 p-5 flex flex-col gap-3 group hover:-translate-y-1 hover:shadow-xl hover:shadow-black/30 ${


                    site.is_featured


                      ? "border-amber-500/40 shadow-lg shadow-amber-500/5"


                      : "border-[#2a3a54] hover:border-amber-500/30"


                  }`}


                >


                  {/* Featured Star */}


                  {site.is_featured && (


                    <div className="absolute top-3 left-3">


                      <Star className="w-4 h-4 text-amber-400 fill-amber-400" />


                    </div>


                  )}


                  {/* Header */}


                  <div>


                    <h3


                      className="text-white font-bold text-lg leading-tight mb-1 pl-6"


                      style={{ fontFamily: "Cairo, sans-serif" }}


                    >


                      {site.name_ar}


                    </h3>


                    {site.name_en && (


                      <p className="text-gray-500 text-xs" dir="ltr">


                        {site.name_en}


                      </p>


                    )}


                  </div>


                  {/* Badges */}


                  <div className="flex flex-wrap gap-2">


                    {site.category && (


                      <span


                        className={`text-xs px-2.5 py-0.5 rounded-full font-medium ${


                          CATEGORY_COLORS[site.category] || "bg-gray-800 text-gray-400"


                        }`}


                        style={{ fontFamily: "Tajawal, sans-serif" }}


                      >


                        {site.category}


                      </span>


                    )}


                    {site.country && (


                      <span


                        className="text-xs px-2.5 py-0.5 rounded-full bg-[#2a3a54] text-gray-300 border border-[#3a4a64]"


                        style={{ fontFamily: "Tajawal, sans-serif" }}


                      >


                        {site.country}


                      </span>


                    )}


                  </div>


                  {/* Description */}


                  {site.description_ar && (


                    <p


                      className="text-gray-400 text-sm leading-relaxed flex-1"


                      style={{ fontFamily: "Tajawal, sans-serif" }}


                    >


                      {site.description_ar}


                    </p>


                  )}


                  {/* URL Display */}


                  <p className="text-gray-600 text-xs truncate" dir="ltr">


                    {site.url}


