                            : "text-gray-400 hover:text-gray-200 hover:bg-white/5"


                          }


                        `}


                        style={{ fontFamily: "Tajawal, sans-serif" }}


                      >


                        <Icon className={`w-4 h-4 flex-shrink-0 ${active ? "text-amber-400" : "text-gray-500"}`} />


                        <span className="flex-1 truncate">{item.label}</span>


                        {item.isPro && <ProBadge />}


                      </Link>


                    );


                  })}


                </div>


              )}


            </div>


          );


        })}


      </nav>


      {/* Footer */}


      <div className="px-4 py-4 border-t border-[#2a3a54]">


        <div className="flex items-center gap-3">


          <div className="w-8 h-8 rounded-full bg-amber-500/20 flex items-center justify-center">


            <User className="w-4 h-4 text-amber-400" />


          </div>


          <div className="flex-1 min-w-0">


            <p className="text-white text-sm font-medium truncate" style={{ fontFamily: "Tajawal, sans-serif" }}>


              {user?.firstName || "المستخدم"} {user?.lastName || ""}


            </p>


            <p className="text-gray-500 text-xs truncate">{user?.email || ""}</p>


          </div>


          {isPro && (


            <span className="text-[10px] font-bold bg-amber-500 text-[#1a2234] px-1.5 py-0.5 rounded-full">


              PRO


            </span>


          )}


        </div>


      </div>


    </aside>


  );


}


