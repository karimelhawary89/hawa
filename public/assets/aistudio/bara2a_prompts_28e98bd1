## STEP C1: Create `src/components/BaraaAssistant.tsx`


Check if this file already exists. If it exists and is functional, skip. If it does not exist or is broken, create it with the following complete implementation:


```tsx


import React, { useState, useRef, useEffect } from "react";


import { Bot, X, Send, Minimize2 } from "lucide-react";


import { useAuth } from "zite-auth-sdk";


import { chat } from "zite-endpoints-sdk";


interface Message {


  id: string;


  role: "user" | "assistant";


  content: string;


}


export default function BaraaAssistant() {


  const { user } = useAuth();


  const [isOpen, setIsOpen] = useState(false);


  const [messages, setMessages] = useState<Message[]>([


    {


      id: "welcome",


      role: "assistant",


      content: "مرحبًا! أنا براءة، مساعدك القانوني الذكي. كيف يمكنني مساعدتك اليوم؟",


    },


  ]);


  const [inputValue, setInputValue] = useState("");


  const [isStreaming, setIsStreaming] = useState(false);


  const messagesEndRef = useRef<HTMLDivElement>(null);


  const inputRef = useRef<HTMLInputElement>(null);


  useEffect(() => {


    if (isOpen && messagesEndRef.current) {


      messagesEndRef.current.scrollIntoView({ behavior: "smooth" });


    }


  }, [messages, isOpen]);


  useEffect(() => {


    if (isOpen && inputRef.current) {


      setTimeout(() => inputRef.current?.focus(), 100);


    }


  }, [isOpen]);


  async function handleSend() {


    if (!inputValue.trim() || isStreaming) return;


    const userMsg: Message = {


      id: `user-${Date.now()}`,


      role: "user",


      content: inputValue.trim(),


    };


    setMessages((prev) => [...prev, userMsg]);


    setInputValue("");


    setIsStreaming(true);


    const assistantMsgId = `assistant-${Date.now()}`;


    setMessages((prev) => [


      ...prev,


      { id: assistantMsgId, role: "assistant", content: "" },


    ]);


    try {


      const history = messages


        .filter((m) => m.id !== "welcome")


        .map((m) => ({ role: m.role, content: m.content }));


      let accumulated = "";


      await chat(


        {


          message: userMsg.content,


          conversationHistory: history,


          systemPrompt:


            "أنت براءة، مساعد قانوني ذكي متخصص في القانون المصري والعربي. أجب باللغة العربية دائمًا وكن دقيقًا ومفيدًا في إجاباتك القانونية.",


        },


        (chunk: string) => {


          accumulated += chunk;


          setMessages((prev) =>


            prev.map((m) =>


              m.id === assistantMsgId ? { ...m, content: accumulated } : m


            )


          );


        }


      );


    } catch (err) {


      setMessages((prev) =>


        prev.map((m) =>


          m.id === assistantMsgId


            ? { ...m, content: "عذرًا، حدث خطأ. يرجى المحاولة مرة أخرى." }


            : m


        )


      );


    } finally {


      setIsStreaming(false);


    }


  }


  function handleKeyDown(e: React.KeyboardEvent) {


    if (e.key === "Enter" && !e.shiftKey) {


      e.preventDefault();


      handleSend();


    }


  }


  if (!user) return null;


  return (


    <>


      {/* Floating Button */}


      {!isOpen && (


        <button


          onClick={() => setIsOpen(true)}


          className="fixed bottom-6 left-6 z-[2000] w-14 h-14 rounded-full bg-amber-500 hover:bg-amber-400 shadow-lg shadow-amber-500/30 flex items-center justify-center transition-all duration-300 hover:scale-110 animate-pulse"


          aria-label="فتح مساعد براءة"


          style={{ boxShadow: "0 0 20px rgba(245,158,11,0.4)" }}


        >


          <Bot className="w-7 h-7 text-[#1a2234]" />


        </button>


      )}


      {/* Chat Drawer */}


      {isOpen && (


        <div


          className="fixed bottom-6 left-6 z-[2000] w-96 h-[560px] bg-[#1e2a40] border border-[#2a3a54] rounded-2xl shadow-2xl shadow-black/50 flex flex-col overflow-hidden"


          dir="rtl"


          style={{ boxShadow: "0 25px 50px -12px rgba(0,0,0,0.7)" }}


        >


          {/* Header */}


          <div className="bg-gradient-to-l from-amber-500/20 to-transparent border-b border-[#2a3a54] px-4 py-3 flex items-center justify-between">


            <div className="flex items-center gap-2">


              <div className="w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center">


                <Bot className="w-4 h-4 text-[#1a2234]" />


              </div>


              <div>


                <p className="text-white font-bold text-sm" style={{ fontFamily: "Cairo, sans-serif" }}>


                  براءة


                </p>


                <p className="text-green-400 text-xs" style={{ fontFamily: "Tajawal, sans-serif" }}>


                  متصل الآن


                </p>


              </div>


            </div>


            <button


              onClick={() => setIsOpen(false)}


              className="text-gray-400 hover:text-white transition-colors"


            >


              <X className="w-5 h-5" />


            </button>


          </div>


          {/* Messages */}


          <div className="flex-1 overflow-y-auto p-4 space-y-3">


            {messages.map((msg) => (


              <div


                key={msg.id}


                className={`flex ${msg.role === "user" ? "justify-start" : "justify-end"}`}


              >


                <div


                  className={`max-w-[80%] rounded-2xl px-3 py-2 text-sm leading-relaxed ${


                    msg.role === "user"


                      ? "bg-amber-500 text-[#1a2234] font-medium rounded-tr-sm"


                      : "bg-[#2a3a54] text-gray-200 rounded-tl-sm"


                  }`}


                  style={{ fontFamily: "Tajawal, sans-serif" }}


                >


                  {msg.content || (


                    <span className="flex gap-1">


                      <span className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:0ms]" />


                      <span className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:150ms]" />


                      <span className="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce [animation-delay:300ms]" />


                    </span>


                  )}


                </div>


              </div>


            ))}


            <div ref={messagesEndRef} />


          </div>


          {/* Input */}


          <div className="border-t border-[#2a3a54] p-3 flex gap-2">


            <input


              ref={inputRef}


              value={inputValue}


              onChange={(e) => setInputValue(e.target.value)}


              onKeyDown={handleKeyDown}


              placeholder="اكتب سؤالك القانوني..."


              disabled={isStreaming}


              className="flex-1 bg-[#1a2234] border border-[#2a3a54] rounded-xl px-3 py-2 text-white text-sm placeholder:text-gray-500 text-right focus:outline-none focus:border-amber-500/50 disabled:opacity-50"


              style={{ fontFamily: "Tajawal, sans-serif" }}


            />


            <button


              onClick={handleSend}


              disabled={!inputValue.trim() || isStreaming}


              className="w-9 h-9 rounded-xl bg-amber-500 hover:bg-amber-400 flex items-center justify-center disabled:opacity-40 disabled:cursor-not-allowed transition-colors flex-shrink-0"


            >


              <Send className="w-4 h-4 text-[#1a2234]" />


            </button>


          </div>


        </div>


      )}


    </>


  );


}


```


