  {


    title: "الذكاء الاصطناعي",


    items: [


      { label: "المساعد الذكي",   to: "/ai-assistant",   icon: Bot },


      { label: "الذكاء الاصطناعي", to: "/ai-intelligence", icon: Brain },


    ],


  },


  // ── المعرفة — PRO, senior roles only ────────────────────────────────────────


  {


    title: "المعرفة",


    roles: SENIOR_ROLES,


    items: [


      { label: "قاعدة المعرفة",   to: "/knowledge-base",          icon: BookOpen,  pro: true, roles: SENIOR_ROLES },


      { label: "إعدادات المعرفة", to: "/knowledge-base/settings", icon: Settings2, pro: true, roles: SENIOR_ROLES },


    ],


  },


  // ── الويدجت والتكامل — PRO, senior roles only ───────────────────────────────


  {


    title: "الويدجت والتكامل",


    roles: SENIOR_ROLES,


    items: [


      { label: "معرض الويدجت",    to: "/widget-gallery", icon: LayoutGrid, pro: true, roles: SENIOR_ROLES },


      { label: "الويدجت المُفعّلة", to: "/my-widgets",    icon: Puzzle,     pro: true, roles: SENIOR_ROLES },


